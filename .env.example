APP_NAME=pinengine
APP_ENV=development

# Superuser (only used by Postgres internal init)
POSTGRES_USER=superuser
POSTGRES_PASSWORD=supersecret

# Primary database name
POSTGRES_DB=${APP_NAME}_${APP_ENV}

# App user
APP_DB_USER=appuser
APP_DB_PASSWORD=appsecret

# Analytics user
ANALYTICS_DB_USER=analyticsuser
ANALYTICS_DB_PASSWORD=analyticssecret

# Defaults for dev mode
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
DEFAULT_PROJECT_ID=00000000-0000-0000-0000-000000000003
DEFAULT_PROFILE_ID=00000000-0000-0000-0000-000000000007
DEV_AUTH_BYPASS=true
