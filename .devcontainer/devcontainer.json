{
  "name": "Content Generation Worker Dev Container For Development",
  "build": {
    "dockerfile": "../services/content-generation-worker/Dockerfile",
    "context": ".."
  },

  "workspaceFolder": "/app",
  "workspaceMount": "source=${localWorkspaceFolder},target=/app,type=bind,consistency=cached",

  // Keep container alive for interactive dev
  "overrideCommand": true,

  // Join your compose network so hostnames like `db` / `redis` resolve
  "runArgs": ["--env-file=./config/dev/variables.env", "--network=content_automation_engine_development"],

  // Mount secret files exactly like Compose `/run/secrets/...`
  "mounts": [
    "source=${localWorkspaceFolder}/secrets/openai-api-key.txt,target=/run/secrets/openai-api-key,type=bind,readonly",
    "source=${localWorkspaceFolder}/secrets/azure-blob-storage-connection-string.txt,target=/run/secrets/azure-blob-storage-connection-string,type=bind,readonly",
    "source=${localWorkspaceFolder}/secrets/azure-foundry-proj-default-api-key.txt,target=/run/secrets/azure-foundry-proj-default-api-key,type=bind,readonly"
  ],

  // Env vars inside the container
  "containerEnv": {
    "PYTHONPATH": "/app/services/content-generation-worker/app/content_generation_worker:/app/services/content-generation-worker/app:/app",
    // App expects envs to point at the mounted secret files (same as your Compose pattern)
    "OPENAI_API_KEY": "/run/secrets/openai-api-key"
    ,"AZURE_BLOB_STORAGE_CONNECTION_STRING": "/run/secrets/azure-blob-storage-connection-string"
    ,"AZURE_FOUNDRY_PROJ_DEFAULT_API_KEY": "/run/secrets/azure-foundry-proj-default-api-key"
  },

  // Build DB_URL from variables loaded by env-file
  "remoteEnv": {
    "DB_URL": "postgresql+asyncpg://${containerEnv:APP_DB_USER}:${containerEnv:APP_DB_PASSWORD}@db:5432/${containerEnv:APP_NAME}_${containerEnv:APP_ENV}"
  },
  
  "forwardPorts": [5678],

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy"
      ]
    }
  },

  "postCreateCommand": "pip install debugpy && pip install -e /app/common --config-settings editable_mode=strict"
}
