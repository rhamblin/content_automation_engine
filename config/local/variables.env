APP_ENVIRONMENT=local
LOG_LEVEL=DEBUG
AZURE_FOUNDRY_ENDPOINT=https://contentenginefoundrydev.openai.azure.com/
APP_NAME=contentengine

# DB Config
DATABASE_URL=postgresql+asyncpg://appuser:appsecret@db:5432/contentengine_local

# Superuser (only used by Postgres’s internal init):
POSTGRES_USER=superuser
POSTGRES_PASSWORD=supersecret
POSTGRES_DB_NAME=${APP_NAME}_${APP_ENVIRONMENT}

# App user (read/write)
APP_DB_USER=appuser
APP_DB_PASSWORD=appsecret

# Analytics user (read-only)
ANALYTICS_DB_USER=analyticsuser
ANALYTICS_DB_PASSWORD=analyticssecret

# Azure Foundry
