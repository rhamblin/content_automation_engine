{
  "name": "split_reveal",
  "channel": "pinterest",
  "description": "Split duplicate layout — same photo top and bottom with a bold green banner and title in the center.",
  "spec": {
    "layout": {
      "type": "split_reveal",
      "split_pct": 0.45,
      "gap": 160,
      "color": "#2D6A4F",
      "crop_focus_top": "center",
      "crop_focus_bottom": "center"
    },
    "title": {
      "font_file": "BebasNeue.ttf",
      "font_size": 110,
      "color": "#FFFFFF",
      "y_position": 0.467,
      "outline_width": 0,
      "max_lines": 1
    },
    "watermark": {
      "font_file": "DancingScript.ttf",
      "font_size": 48,
      "color": "#FFFFFF",
      "y_position": -0.04,
      "alignment": "right",
      "outline_width": 2,
      "outline_color": "#5C3A1E"
    },
    "overlays": [
      {
        "position": "center",
        "color": "#2D6A4F",
        "opacity": 1.0,
        "height_pct": 0.12,
        "y_position": 0.500
      }
    ]
  }
}
